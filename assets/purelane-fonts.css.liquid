{% comment %}
  Purelane display + text faces, self-hosted on the Shopify CDN.

  Why this file is .css.liquid: it is the only Purelane stylesheet that needs
  `asset_url`, so the font files resolve against the versioned CDN path instead
  of a relative /assets/ guess. Everything else is plain .css.

  Subsetting: the prototype pulled 9 static weights from fonts.googleapis.com
  (two extra connections, ~230 KB). These are the variable builds, latin subset
  only, plus a 2 KB U+20B9 slice so the rupee sign renders without pulling the
  whole latin-ext block (85 KB for one glyph).
{% endcomment %}

@font-face {
  font-family: 'Purelane Text';
  font-style: normal;
  font-weight: 400 800;
  font-display: swap;
  src: url({{ 'purelane-inter-latin.woff2' | asset_url }}) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
    U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Purelane Text';
  font-style: normal;
  font-weight: 400 800;
  font-display: swap;
  src: url({{ 'purelane-inter-rupee.woff2' | asset_url }}) format('woff2');
  unicode-range: U+20B9;
}

@font-face {
  font-family: 'Purelane Display';
  font-style: normal;
  font-weight: 500 800;
  font-display: swap;
  src: url({{ 'purelane-outfit-latin.woff2' | asset_url }}) format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308,
    U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}

@font-face {
  font-family: 'Purelane Display';
  font-style: normal;
  font-weight: 500 800;
  font-display: swap;
  src: url({{ 'purelane-outfit-rupee.woff2' | asset_url }}) format('woff2');
  unicode-range: U+20B9;
}
