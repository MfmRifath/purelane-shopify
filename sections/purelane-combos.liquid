{%- comment -%}
  Purelane — best-selling combos  (#combos in the prototype)

  Combos are `purelane_combo` metaobject entries. A merchant adds a combo in
  Content → Metaobjects and it appears here; the theme has no list of combos in
  it. If the section's picker is left empty every published entry is used, so
  the section works the moment the metaobjects exist.
{%- endcomment -%}

{{ 'purelane-fonts.css' | asset_url | stylesheet_tag }}
{{ 'purelane-core.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign combos = section.settings.combos
  if combos.size == 0
    assign combos = shop.metaobjects.purelane_combo.values
  endif
  assign anchor = section.settings.anchor | handle
-%}

<section
  {% if anchor != blank %}id="{{ anchor }}"{% endif %}
  class="pl pl-combos"
  data-pl-scene="{{ section.settings.scene }}"
  {% if section.settings.rail_label != blank %}
    data-pl-rail-label="{{ section.settings.rail_label | escape }}"
  {% endif %}
  style="--pl-pt:{{ section.settings.padding_top }}px;--pl-pb:{{ section.settings.padding_bottom }}px;"
>
  <div class="pl-wrap">
    {%- render 'purelane-section-head',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede,
      show_rule: section.settings.show_rule
    -%}

    {%- if combos.size > 0 -%}
      <div
        class="pl-comborail pl-rv"
        role="region"
        aria-label="{{ section.settings.heading | default: 'Combos' | escape }}"
        tabindex="0"
      >
        {%- for combo in combos limit: section.settings.combos_to_show -%}
          {%- render 'purelane-combo-card', combo: combo, stack_limit: section.settings.stack_limit -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.swipe_cue != blank -%}
        <div class="pl-swipecue" aria-hidden="true">
          {%- render 'purelane-icon', name: 'arrow-right' -%}
          {{ section.settings.swipe_cue }}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="pl-railnote">{{ section.settings.note }}</p>
      {%- endif -%}

    {%- elsif request.design_mode -%}
      <p class="pl-body-s pl-empty">{{ 'purelane.editor.no_combos' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane combos",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro text",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Combos"
    },
    {
      "type": "metaobject_list",
      "id": "combos",
      "metaobject_type": "purelane_combo",
      "label": "Combos",
      "limit": 12,
      "info": "Leave empty to show every published combo. Create them in Content → Metaobjects."
    },
    {
      "type": "range",
      "id": "combos_to_show",
      "label": "Combos to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "stack_limit",
      "label": "Products shown per combo",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "How many product images fit in the tray. The count line still reflects the full combo."
    },
    {
      "type": "header",
      "content": "Below the rail"
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "Swipe hint",
      "default": "Swipe for more combos"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "combos"
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Progress rail label",
      "default": "Combos"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "presets": [
    {
      "name": "Purelane combos"
    }
  ]
}
{% endschema %}
