{%- comment -%}
  Purelane — bundles  (#bundles in the prototype)

  Each tier is a block, so tiers can be added, removed and reordered in the
  theme editor. Price, compare-at price, the per-product figure and the link
  all come off a real bundle product; the theme only holds the copy around it.
{%- endcomment -%}

{{ 'purelane-fonts.css' | asset_url | stylesheet_tag }}
{{ 'purelane-core.css' | asset_url | stylesheet_tag }}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-motion.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign anchor = section.settings.anchor | handle
  assign tier_cols = section.blocks.size | at_most: 4 | at_least: 1
-%}

<section
  {% if anchor != blank %}id="{{ anchor }}"{% endif %}
  class="pl pl-bundles"
  data-pl-scene="{{ section.settings.scene }}"
  {% if section.settings.rail_label != blank %}
    data-pl-rail-label="{{ section.settings.rail_label | escape }}"
  {% endif %}
  style="--pl-pt:{{ section.settings.padding_top }}px;--pl-pb:{{ section.settings.padding_bottom }}px;--pl-tier-cols:{{ tier_cols }};"
>
  <div class="pl-wrap">
    {%- if section.settings.heading != blank or section.settings.kicker != blank or section.settings.lede != blank -%}
      <div class="pl-glass pl-pad pl-rv pl-bundles__intro">
        {%- render 'purelane-section-head',
          kicker: section.settings.kicker,
          heading: section.settings.heading,
          lede: section.settings.lede,
          show_rule: section.settings.show_rule,
          reveal: false
        -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pl-tiers">
        {%- for block in section.blocks -%}
          {%- liquid
            assign bundle = block.settings.product
            assign previews = block.settings.preview_products
            assign quantity = block.settings.quantity | at_least: 1

            assign unit_note = block.settings.unit_note
            if unit_note == blank and block.settings.show_unit_note and bundle != blank
              assign unit_amount = bundle.price | divided_by: quantity | money
              assign unit_note = 'purelane.bundles.per_product' | t: amount: unit_amount
            endif

            assign cta_url = block.settings.button_link
            if cta_url == blank
              assign cta_url = bundle.url
            endif

            assign delay = forloop.index0
            assign delay_class = ''
            if delay > 0
              assign delay_class = ' pl-rv--' | append: delay
            endif

            assign dense = ''
            if previews.size > 3
              assign dense = ' pl-tierpix--dense'
            endif
          -%}

          <article
            class="pl-glass pl-tier pl-rv{{ delay_class }}{% if block.settings.highlight %} pl-tier--best{% endif %}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.tag != blank -%}
              <span class="pl-tier__tag">{{ block.settings.tag }}</span>
            {%- endif -%}

            {%- if previews.size > 0 -%}
              <div class="pl-tierpix{{ dense }}" aria-hidden="true">
                {%- for item in previews limit: 5 -%}
                  {%- render 'purelane-product-media',
                    product: item,
                    sizes: '62px',
                    widths: '60,90,120,160',
                    alt: ''
                  -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="pl-tier__qty">
              {{- quantity -}}
              {%- if block.settings.quantity_label != blank -%}
                <small>{{ block.settings.quantity_label }}</small>
              {%- endif -%}
            </div>

            {%- if bundle != blank -%}
              {%- render 'purelane-price',
                price: bundle.price,
                compare_at_price: bundle.compare_at_price,
                style: 'tier',
                savings: 'none'
              -%}
            {%- endif -%}

            {%- if unit_note != blank -%}
              <p class="pl-body-s pl-tier__unit">{{ unit_note }}</p>
            {%- endif -%}

            {%- if block.settings.features != blank -%}
              <ul class="pl-tier__list">
                {%- assign features = block.settings.features | strip | newline_to_br | split: '<br />' -%}
                {%- for feature in features -%}
                  {%- assign line = feature | strip -%}
                  {%- if line != blank -%}
                    <li>
                      {%- render 'purelane-icon', name: 'check' -%}
                      <span>{{ line }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if cta_url != blank and block.settings.button_label != blank -%}
              <a
                class="pl-btn pl-btn--block {% if block.settings.button_style == 'primary' %}pl-btn--primary{% else %}pl-btn--ghost{% endif %}"
                href="{{ cta_url }}"
              >
                {{ block.settings.button_label }}
                {%- if block.settings.tag != blank -%}
                  <span class="pl-visually-hidden">, {{ block.settings.tag }}</span>
                {%- endif -%}
                {%- if block.settings.button_style == 'primary' -%}
                  {%- render 'purelane-icon', name: 'arrow-right' -%}
                {%- endif -%}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="pl-body-s pl-empty">{{ 'purelane.editor.no_tiers' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane bundles",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Intro panel"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": false
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "bundles"
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Progress rail label",
      "default": "Bundles"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Most popular"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Bundle product",
          "info": "Price, compare-at price and the button link come from this product."
        },
        {
          "type": "number",
          "id": "quantity",
          "label": "Number of products",
          "default": 3
        },
        {
          "type": "text",
          "id": "quantity_label",
          "label": "Label under the number",
          "default": "Products"
        },
        {
          "type": "product_list",
          "id": "preview_products",
          "label": "Products shown in the strip",
          "limit": 5
        },
        {
          "type": "checkbox",
          "id": "show_unit_note",
          "label": "Show the per-product price",
          "default": true
        },
        {
          "type": "text",
          "id": "unit_note",
          "label": "Per-product text",
          "info": "Leave blank to calculate it from the bundle price."
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "info": "One per line.",
          "default": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Highlight this tier",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link",
          "info": "Defaults to the bundle product page."
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "ghost", "label": "Outline" },
            { "value": "primary", "label": "Solid" }
          ],
          "default": "ghost"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag": "Starter",
            "quantity": 2,
            "features": "Pick any two products\nFree shipping across India",
            "button_style": "ghost"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "quantity": 3,
            "highlight": true,
            "features": "Pick any three products\nCovers kitchen and laundry\nFree shipping across India",
            "button_style": "primary"
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Whole home",
            "quantity": 5,
            "features": "Pick any five products\nEvery room in one order\nFree shipping across India",
            "button_style": "ghost"
          }
        }
      ]
    }
  ]
}
{% endschema %}
