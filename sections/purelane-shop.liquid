{%- comment -%}
  Purelane — shop / product grid  (#shop in the prototype)

  Products come from a collection or a hand-picked list; every card is rendered
  by `purelane-product-card`, which is the same card the rest of the theme can
  reuse. Nothing about a product is typed into this section.
{%- endcomment -%}

{{ 'purelane-fonts.css' | asset_url | stylesheet_tag }}
{{ 'purelane-core.css' | asset_url | stylesheet_tag }}
{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-motion.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.quick_add -%}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  if section.settings.source == 'collection'
    assign products = section.settings.collection.products
  else
    assign products = section.settings.products
  endif

  assign limit = section.settings.products_to_show
  assign anchor = section.settings.anchor | handle
-%}

<section
  {% if anchor != blank %}id="{{ anchor }}"{% endif %}
  class="pl pl-shop"
  data-pl-scene="{{ section.settings.scene }}"
  {% if section.settings.rail_label != blank %}
    data-pl-rail-label="{{ section.settings.rail_label | escape }}"
  {% endif %}
  style="--pl-pt:{{ section.settings.padding_top }}px;--pl-pb:{{ section.settings.padding_bottom }}px;--pl-cols:{{ section.settings.columns_desktop }};--pl-cols-mobile:{{ section.settings.columns_mobile }};"
>
  <div class="pl-wrap">
    {%- render 'purelane-section-head',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede,
      show_rule: section.settings.show_rule
    -%}

    {%- if products.size > 0 -%}
      <div class="pl-shelf">
        {%- for product in products limit: limit -%}
          {%- liquid
            assign delay = forloop.index0 | modulo: section.settings.columns_desktop
            assign loading = 'lazy'
            if forloop.index <= section.settings.columns_desktop and section.settings.eager_first_row
              assign loading = 'eager'
            endif
          -%}
          {%- render 'purelane-product-card',
            product: product,
            section_id: section.id,
            show_rating: section.settings.show_rating,
            show_badge: section.settings.show_badge,
            quick_add: section.settings.quick_add,
            button_label: section.settings.button_label,
            image_loading: loading,
            reveal_delay: delay,
            columns: section.settings.columns_desktop
          -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
        <div class="pl-shop__more pl-rv">
          <a class="pl-btn pl-btn--primary" href="{{ section.settings.view_all_link }}">
            {{ section.settings.view_all_label }}
            {%- render 'purelane-icon', name: 'arrow-right' -%}
          </a>
        </div>
      {%- endif -%}

    {%- elsif request.design_mode -%}
      <p class="pl-body-s pl-empty">{{ 'purelane.editor.no_products' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane shop grid",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "text",
      "id": "lede",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show leaf divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "manual", "label": "Hand-picked products" }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12,
      "info": "Used when the source is set to hand-picked."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge",
      "default": true,
      "info": "Reads the product metafield custom.card_badge. Falls back to Sale, and always shows Sold out when there is no stock."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true,
      "info": "Reads the standard reviews.rating and reviews.rating_count product metafields."
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "Add to cart from the card",
      "default": true,
      "info": "Single-variant products only. Products with options link through to the product page."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Leave blank to use Add to cart."
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "shop",
      "info": "Used by in-page links such as #shop. Leave blank to omit."
    },
    {
      "type": "text",
      "id": "rail_label",
      "label": "Progress rail label",
      "default": "Shop"
    },
    {
      "type": "range",
      "id": "scene",
      "label": "Backdrop depth",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "info": "1 is the shallow, brightest water. 4 is the deepest."
    },
    {
      "type": "checkbox",
      "id": "eager_first_row",
      "label": "Load the first row of images eagerly",
      "default": false,
      "info": "Turn on only if this section is above the fold."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "presets": [
    {
      "name": "Purelane shop grid"
    }
  ]
}
{% endschema %}
